{
  "sourceLanguage": "en",
  "strings": {
    "account.language.error": {
      "comment": "TV-only — no web counterpart (Phase 5 Task 5); flagged for Phase 6 audit.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache konnte nicht geändert werden. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change the language. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el idioma. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer la langue. Réessayez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar o idioma. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить язык. Попробуйте ещё раз."
          }
        }
      }
    },
    "account.menu.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, welche Kategorien in deinem Menü erscheinen, und ordne sie an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which categories show in your menu and put them in order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué categorías aparecen en tu menú y ordénalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les catégories à afficher dans votre menu et classez-les."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais categorias aparecem no seu menu e ordene-as."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие категории показывать в меню, и расположите их по порядку."
          }
        }
      }
    },
